async def router(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    text = update.message.text
    
    # Update state based on navigation
    if text == "🏠 Home":
        user_states[user_id] = States.HOME
        await home_menu(update)
    elif text == "➕ Create":
        user_states[user_id] = States.CREATE
        await create_handler(update)
    elif text == "💬 Messenger":
        user_states[user_id] = States.MESSENGER
        await messenger_handler(update)
    elif text == "⚙️ Settings":
        user_states[user_id] = States.SETTINGS
        await settings_handler(update)
    elif text == "⬅️ Back":
        user_states[user_id] = States.HOME
        await update.message.reply_text("⬅️ Back to main menu", reply_markup=main_menu())
    else:
        # Handle sub-menu items based on current state
        current_state = user_states.get(user_id, States.HOME)
        await handle_submenu(update, context, current_state, text)

