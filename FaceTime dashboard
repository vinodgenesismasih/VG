        function switchTab(tabId) {
            // Hide all tabs
            document.querySelectorAll('.tab-content').forEach(tab => {
                tab.style.display = 'none';
            });
            
            // Remove active class from all nav items
            document.querySelectorAll('.nav-item').forEach(item => {
                item.classList.remove('active');
            });
            
            // Show selected tab
            const tab = document.getElementById(tabId);
            if (tab) {
                tab.style.display = 'block';
                tab.classList.add('fade-in');
            }
            
            // Add active class to clicked nav item
            const navItem = document.querySelector(`.nav-item[href="#${tabId}"]`);
            if (navItem) {
                navItem.classList.add('active');
            }
            
            // Update page title
            updatePageTitle(tabId);
            
            // Close mobile sidebar if open
            if (window.innerWidth < 1200) {
                document.getElementById('sidebar').classList.remove('active');
            }
        }

        function updatePageTitle(tabId) {
            const titles = {
                'home': 'FaceTime Dashboard',
                'profile': 'User Profile',
                'create-story': 'Create Story',
                'messages': 'Messages',
                'settings': 'Settings',
                'games': 'Games',
                'platform-api': 'Platform API',
                'generation-creators': 'Generation Creators',
                'api-search': 'API Search',
                'apps-new': 'New Apps',
                'monetization': 'Monetization',
                'suggestions': 'Suggestions',
                'notifications': 'Notifications'
            };
            
            const subtitles = {
                'home': 'Welcome to your AI communication platform',
                'profile': 'Manage your profile and settings',
                'create-story': 'Create and share stories',
                'messages': 'Chat and video calls',
                'settings': 'Configure your preferences',
                'games': 'Play interactive games',
                'platform-api': 'Access API documentation',
                'generation-creators': 'AI content generation tools',
                'api-search': 'Search API endpoints',
                'apps-new': 'Download new applications',
                'monetization': 'Revenue and earnings',
                'suggestions': 'Feature suggestions',
                'notifications': 'Recent notifications'
            };
            
            document.getElementById('pageTitle').textContent = titles[tabId] || 'FaceTime';
            document.getElementById('pageSubtitle').textContent = subtitles[tabId] || 'AI Communication Platform';
        }

        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('active');
        }

        function toggleTheme() {
            const currentTheme = document.documentElement.getAttribute('data-theme');
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            
            document.documentElement.setAttribute('data-theme', newTheme);
            localStorage.setItem('theme', newTheme);
            
            updateThemeIcon(newTheme);
        }

        function updateThemeIcon(theme) {
            const themeBtn = document.querySelector('[onclick="toggleTheme()"] i');
            if (theme === 'dark') {
                themeBtn.className = 'fas fa-sun';
            } else {
                themeBtn.className = 'fas fa-moon';
            }
        }

        function refreshData() {
            const refreshBtn = document.querySelector('[onclick="refreshData()"]');
            const originalIcon = refreshBtn.innerHTML;
            refreshBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            
            setTimeout(() => {
                refreshBtn.innerHTML = originalIcon;
                
                // Update stats with random values for demo
                updateRandomStats();
                
                showNotification('Data refreshed successfully!', 'success');
            }, 1000);
        }

        function updateRandomStats() {
            const statValues = document.querySelectorAll('.stat-value');
            statValues.forEach(stat => {
                if (stat.textContent.includes('$') || !isNaN(stat.textContent.replace(/[^0-9]/g, ''))) {
                    const current = parseInt(stat.textContent.replace(/[^0-9]/g, ''));
                    const change = Math.floor(Math.random() * 200) - 50;
                    const newValue = Math.max(100, current + change);
                    
                    if (stat.textContent.includes('$')) {
                        stat.textContent = '$' + newValue.toLocaleString();
                    } else {
                        stat.textContent = newValue.toLocaleString();
                    }
                }
            });
        }

        function searchContent(query) {
            if (query.length > 2) {
                console.log('Searching for:', query);
                // Implement actual search logic here
            }
